---
import Layout from '../layouts/default.astro';
import { getFormattedDate } from '../utils/date.js';
import {
  PageHeader,
  PageHeadingGroup,
  PageLead,
  PageTitle,
} from '../design-system/index.js';

type PostModule = {
  url: string;
  frontmatter: {
    title: string;
    publishDate: string;
    canonical_url?: string;
    image?: string;
    imageAlt?: string;
    imageWidth?: number;
    imageHeight?: number;
    excerpt?: string;
  };
};

const postImports = import.meta.glob('./blog/*.{md,mdx}', { eager: true });
const posts = (Object.values(postImports) as PostModule[]).sort(
  (a, b) =>
    new Date(b.frontmatter.publishDate).valueOf() -
    new Date(a.frontmatter.publishDate).valueOf()
);

const myBlog = posts.filter(post => !post.frontmatter.canonical_url);
const archive = posts.filter(post => !!post.frontmatter.canonical_url);
const [featured, ...remainingPosts] = myBlog;
---

<Layout
  title="Blog"
  description="Longer notes and experiments from Dominik Kundel about AI, JavaScript, developer tools, and things with questionable APIs."
>
  <PageHeader>
    <PageHeadingGroup>
      <p class="eyebrow">Personal archive</p>
      <PageTitle>Notes and experiments.</PageTitle>
      <PageLead>
        Longer pieces written here—usually where software, AI, product, and
        curiosity collide. For everything published elsewhere, visit <a href="/writing">Writing</a>.
      </PageLead>
    </PageHeadingGroup>
  </PageHeader>

  {featured ? (
    <article>
      <a class="blog-feature card interactive-card" href={featured.url}>
        {featured.frontmatter.image ? (
          <img
            class="blog-feature__image"
            src={featured.frontmatter.image}
            alt={featured.frontmatter.imageAlt || ''}
            width={featured.frontmatter.imageWidth || 1200}
            height={featured.frontmatter.imageHeight || 630}
            decoding="async"
            fetchpriority="high"
          />
        ) : null}
        <div class="blog-feature__copy">
          <p class="section-kicker">Latest · {getFormattedDate(featured.frontmatter.publishDate)}</p>
          <h2 class="blog-feature__title">{featured.frontmatter.title}</h2>
          {featured.frontmatter.excerpt ? (
            <p class="blog-feature__excerpt">{featured.frontmatter.excerpt}</p>
          ) : null}
        </div>
      </a>
    </article>
  ) : null}

  {remainingPosts.length > 0 ? (
    <section class="writing-section" aria-labelledby="more-posts-title">
      <p class="section-kicker">More from the archive</p>
      <h2 class="page-subheading" id="more-posts-title">Personal posts</h2>
      <ul class="blog-list">
        {remainingPosts.map(post => (
          <li>
            <a class="blog-list__link" href={post.url}>
              {post.frontmatter.image ? (
                <img
                  class="blog-list__image"
                  src={post.frontmatter.image}
                  alt=""
                  width={post.frontmatter.imageWidth || 1200}
                  height={post.frontmatter.imageHeight || 630}
                  loading="lazy"
                  decoding="async"
                />
              ) : <span class="blog-list__image" aria-hidden="true" />}
              <span>
                <span class="blog-list__title">{post.frontmatter.title}</span>
                <span class="article-meta">{getFormattedDate(post.frontmatter.publishDate)}</span>
              </span>
              <span class="feature-row__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : null}

  {archive.length > 0 ? (
    <section class="writing-section" aria-labelledby="republished-title">
      <p class="section-kicker">Republished</p>
      <h2 class="page-subheading" id="republished-title">Archived from elsewhere</h2>
      <ul class="archive-list">
        {archive.map(post => (
          <li class="archive-row">
            <a href={post.url}>
              <span class="archive-row__title">{post.frontmatter.title}</span>
              <time class="archive-row__meta" datetime={post.frontmatter.publishDate}>
                {getFormattedDate(post.frontmatter.publishDate)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : null}
</Layout>
