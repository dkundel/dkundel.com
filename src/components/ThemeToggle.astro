<button
  class="theme-toggle"
  type="button"
  aria-label="Use dark theme"
  aria-pressed="false"
  data-theme-toggle
>
  <svg class="theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.4 15.3A8.5 8.5 0 0 1 8.7 3.6a8.5 8.5 0 1 0 11.7 11.7Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <svg class="theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.8" fill="none" stroke="currentColor" stroke-width="1.8" />
    <path d="M12 2.2v2M12 19.8v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2.2 12h2M19.8 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </svg>
</button>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-theme-toggle]');
    if (!(button instanceof HTMLButtonElement)) return;

    const syncLabel = () => {
      const isDark = document.documentElement.classList.contains('dark');
      button.setAttribute('aria-pressed', String(isDark));
      button.setAttribute('aria-label', isDark ? 'Use light theme' : 'Use dark theme');
    };

    button.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        // The visual theme still changes when storage is unavailable.
      }
      syncLabel();
    });

    syncLabel();
  })();
</script>
