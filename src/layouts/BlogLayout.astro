---
import { getFormattedDate } from '../utils/date.js';
import Layout from './default.astro';
import '../styles/blog.css';

const { frontmatter } = Astro.props;
const tags: string[] = Array.isArray(frontmatter.tags) ? frontmatter.tags : [];
---

<Layout
  fullTitle={frontmatter.title}
  canonical_url={frontmatter.canonical_url}
  image={frontmatter.image}
  description={frontmatter.excerpt}
  type="article"
>
  <article>
    <header class="article-masthead">
      {typeof frontmatter.image === 'string' ? (
        <img
          class="article-masthead__image"
          src={frontmatter.image}
          alt={frontmatter.imageAlt || ''}
          width={frontmatter.imageWidth || 1200}
          height={frontmatter.imageHeight || 630}
          decoding="async"
          fetchpriority="high"
        />
      ) : null}
      <p class="section-kicker">{frontmatter.category || 'Blog'}</p>
      <h1 class="article-title">{frontmatter.title}</h1>
      <div class="article-byline">
        <span>{frontmatter.author || 'Dominik Kundel'}</span>
        <span aria-hidden="true">·</span>
        <time datetime={frontmatter.publishDate}>
          {getFormattedDate(frontmatter.publishDate)}
        </time>
        {tags.length > 0 ? <span aria-hidden="true">·</span> : null}
        <div class="article-tags" aria-label="Tags">
          {tags.map(tag => <span>#{tag}</span>)}
        </div>
      </div>
    </header>

    <div class="editorial-prose inline-code-prose">
      <slot />
    </div>

    <nav class="article-footer" aria-label="Article navigation">
      <a class="button-link" href="/writing">← Back to writing</a>
      <a class="button-link" href="/blog">Personal archive</a>
    </nav>
  </article>
</Layout>
