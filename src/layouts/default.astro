---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import siteMetaData from '../../data/siteMetadata.json';

const {title, fullTitle, canonical_url, image, description, type = 'website'} = Astro.props;
const siteTitle = fullTitle ? fullTitle : title ? `${title} | ${siteMetaData.title}` : siteMetaData.title;
let canonicalURL = new URL(Astro.url.pathname, Astro.site);
if (canonical_url) {
  canonicalURL = canonical_url;
}
let pageImage = new URL('/og-preview.png', Astro.site);
if (image) {
  pageImage = image.startsWith('/') ? new URL(image, Astro.site) : image;
}
const pageDescription = description || siteMetaData.description;
---
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="description" content={pageDescription}>
  <meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#151216" media="(prefers-color-scheme: dark)">
  <meta name="color-scheme" content="light dark">
  <meta property="og:title" content={siteTitle}>
  <meta property="og:description" content={pageDescription}>
  <meta property="og:type" content={type}>
  <meta property="og:image" content={pageImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:creator" content={siteMetaData.author}>
  <meta name="twitter:title" content={siteTitle}>
  <meta name="twitter:description" content={pageDescription}>
  <meta name="twitter:image" content={pageImage}>
  <link rel="shortcut icon" type="image/png" href="/favicon-32.png"/>
  <link rel="apple-touch-icon" href="/favicon-192.png">
  <link rel="icon" href="/favicon-32.png" sizes="32x32">
  <link rel="icon" href="/favicon-128.png" sizes="128x128">
  <link rel="icon" href="/favicon-180.png" sizes="180x180">
  <link rel="icon" href="/favicon-192.png" sizes="192x192">
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" type="application/rss+xml" title={`${siteMetaData.name} RSS feed`} href="/rss.xml" />
  <title>{siteTitle}</title>
  <script is:inline>
    (() => {
      let theme;
      try {
        theme = localStorage.getItem('theme');
      } catch {
        theme = null;
      }
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', theme === 'dark' || (!theme && prefersDark));
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="site-shell">
    <Header name={siteMetaData.name} path={Astro.url.pathname} />
    <main id="main-content" class="page-frame"><slot/></main>
    <Footer />
    <a rel="me" style="display:none;" href="https://mastodon.social/@dkundel">Mastodon</a>
  </div>
</body>
</html>
